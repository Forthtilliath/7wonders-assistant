{
	"expo": {
		"name": "7 Wonders: Assistant",
		"slug": "7wonders-assistant",
		"version": "1.5.0",
		"scheme": "sevenwonders",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "light",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"package": "com.forthtilliath.sevenwondersassistant",
			"versionCode": 7,
			"allowBackup": false,
			"permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.USE_BIOMETRIC",
				"android.permission.USE_FINGERPRINT"
			],
			"adaptiveIcon": {
				"backgroundColor": "#0f172a",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-image",
			"expo-sharing",
			"expo-secure-store",
			[
				"@forthtilliath/expo-config-plugins/withReleaseSigning",
				{
					"propertyPrefix": "SEVENWONDERS"
				}
			],
			"@forthtilliath/expo-config-plugins/withAndroidAbis",
			"expo-font"
		]
	}
}
